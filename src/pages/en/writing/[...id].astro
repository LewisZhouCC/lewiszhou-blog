---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { categoryLabels, paths } from "../../../i18n";
import PostLayout from "../../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => !data.draft && data.lang === "en");
  return posts.map((post) => ({ params: { id: post.data.urlSlug }, props: { post } }));
}

interface Props { post: CollectionEntry<"writing">; }
const { post } = Astro.props;
const { Content } = await render(post);
const translations = await getCollection("writing", ({ data }) => !data.draft && data.translationKey === post.data.translationKey);
const alternates = translations.map((entry) => ({ lang: entry.data.lang, href: paths[entry.data.lang].post(entry.data.urlSlug) }));
---

<PostLayout {...post.data} category={categoryLabels[post.data.lang][post.data.category]} alternates={alternates}>
  <Content />
</PostLayout>
