---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);

const formatDate = (date: Date) => new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(date).replaceAll("/", ".");

const topics = ["系统", "Agent", "产品判断", "构建日志"];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <div>
        <p class="eyebrow">Lewis Zhou · Personal Notes</p>
        <h1>持续<span>求解</span></h1>
      </div>
      <div class="hero-intro">
        <p>把复杂问题，一步步做实。记录系统、Agent、产品判断与构建过程。</p>
        <a class="text-link" href="/writing/">开始阅读 ↗</a>
      </div>
    </div>
    <div class="hero-diagram" aria-hidden="true">
      <div class="orbit"><span class="orbit-dot"></span></div>
      <span class="diagram-note">QUESTION · MODEL · VERIFY · RESULT</span>
    </div>
  </section>

  <section class="writing-section" aria-labelledby="latest-writing">
    <div class="section-heading">
      <div>
        <p class="section-label">Latest writing / 最近文章</p>
        <h2 id="latest-writing">正在求解</h2>
      </div>
      <a class="text-link" href="/writing/">查看全部文章</a>
    </div>
    <div class="post-list">
      {posts.map((post, index) => (
        <a class="post-row" href={`/writing/${post.id}/`}>
          <span class="index-no">{String(index + 1).padStart(2, "0")}</span>
          <h3>{post.data.title}</h3>
          <span class="post-meta">
            <span>{post.data.category}</span>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="topics-section" aria-labelledby="topics-title">
    <p class="section-label">Fields / 长期主题</p>
    <h2 class="page-title" id="topics-title">观察的坐标</h2>
    <div class="topics-grid">
      {topics.map((topic, index) => (
        <div class="topic">
          <span class="index-no">0{index + 1}</span>
          <h3>{topic}</h3>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
