---
const pathname = Astro.url.pathname;

const nav = [
  { href: "/writing/", label: "文章" },
  { href: "/about/", label: "关于" },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Lewis Zhou 首页">
    <span class="wordmark-name">Lewis Zhou</span>
    <span class="wordmark-mark" aria-hidden="true"></span>
  </a>
  <nav aria-label="主导航">
    {nav.map((item) => (
      <a href={item.href} aria-current={pathname.startsWith(item.href) ? "page" : undefined}>
        {item.label}
      </a>
    ))}
    <a class="rss-link" href="/rss.xml">RSS</a>
  </nav>
</header>
