---
import { paths, ui, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  languageHref: string;
}

const { lang, languageHref } = Astro.props;
const pathname = Astro.url.pathname;
const text = ui[lang];

const nav = [
  { href: paths[lang].writing, label: text.navWriting },
  { href: paths[lang].about, label: text.navAbout },
];
---

<header class="site-header">
  <a class="wordmark" href={paths[lang].home} aria-label={`Lewis Zhou ${lang === "en" ? "home" : "首页"}`}>
    <span class="wordmark-name">Lewis Zhou</span>
    <span class="wordmark-mark" aria-hidden="true"></span>
  </a>
  <nav aria-label="主导航">
    {nav.map((item) => (
      <a href={item.href} aria-current={pathname.startsWith(item.href) ? "page" : undefined}>
        {item.label}
      </a>
    ))}
    <a class="rss-link" href={paths[lang].rss}>RSS</a>
    <a class="language-link" href={languageHref} hreflang={lang === "en" ? "zh-CN" : "en"}>{text.otherLanguage}</a>
  </nav>
</header>
