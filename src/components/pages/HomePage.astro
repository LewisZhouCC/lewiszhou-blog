---
import { getCollection } from "astro:content";
import { categoryLabels, paths, ui, type Category, type Locale } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const text = ui[lang];
const localePaths = paths[lang];
const otherLang: Locale = lang === "en" ? "zh-CN" : "en";

const posts = (await getCollection("writing", ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);

const formatDate = (date: Date) => new Intl.DateTimeFormat(lang === "en" ? "en-US" : "zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(date).replaceAll("/", ".");

const topics: Category[] = ["systems", "agents", "product", "build"];
---

<BaseLayout lang={lang} alternates={[
  { lang, href: localePaths.home },
  { lang: otherLang, href: paths[otherLang].home },
]}>
  <section class="hero">
    <div class="hero-copy">
      <div>
        <p class="eyebrow">{text.heroEyebrow}</p>
        <h1>{text.heroTitleFirst}<span>{text.heroTitleSecond}</span></h1>
      </div>
      <div class="hero-intro">
        <p>{text.heroIntro}</p>
        <a class="text-link" href={localePaths.writing}>{text.read}</a>
      </div>
    </div>
    <div class="hero-diagram" aria-hidden="true">
      <div class="orbit"><span class="orbit-dot"></span></div>
      <span class="diagram-note">QUESTION · MODEL · VERIFY · RESULT</span>
    </div>
  </section>

  <section class="writing-section" aria-labelledby="latest-writing">
    <div class="section-heading">
      <div>
        <p class="section-label">{text.latestLabel}</p>
        <h2 id="latest-writing">{text.latestTitle}</h2>
      </div>
      <a class="text-link" href={localePaths.writing}>{text.allWriting}</a>
    </div>
    <div class="post-list">
      {posts.map((post, index) => (
        <a class="post-row" href={localePaths.post(post.data.urlSlug)}>
          <span class="index-no">{String(index + 1).padStart(2, "0")}</span>
          <h3>{post.data.title}</h3>
          <span class="post-meta">
            <span>{categoryLabels[lang][post.data.category]}</span>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="topics-section" aria-labelledby="topics-title">
    <p class="section-label">{text.topicsLabel}</p>
    <h2 class="page-title" id="topics-title">{text.topicsTitle}</h2>
    <div class="topics-grid">
      {topics.map((topic, index) => (
        <div class="topic">
          <span class="index-no">0{index + 1}</span>
          <h3>{categoryLabels[lang][topic]}</h3>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
