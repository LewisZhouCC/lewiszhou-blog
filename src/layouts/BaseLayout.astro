---
import Header from "../components/Header.astro";
import { paths, ui, type Locale } from "../i18n";
import "../styles/global.css";

interface Alternate {
  lang: Locale;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: Locale;
  alternates?: Alternate[];
  pageType?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  category?: string;
  noindex?: boolean;
}

const {
  lang = "en",
  alternates = [],
  pageType = "website",
  publishedAt,
  updatedAt,
  category,
} = Astro.props;

const text = ui[lang];
const title = Astro.props.title ?? text.siteTitle;
const description = Astro.props.description ?? text.siteDescription;
const image = Astro.props.image ?? (lang === "en" ? "/social-card-en.png" : "/social-card.png");
const pageTitle = title === text.siteTitle ? title : `${title} — Lewis Zhou`;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = Astro.site ? new URL(image, Astro.site) : new URL(image, Astro.url);
const siteURL = new URL("/", canonicalURL);
const authorURL = new URL(paths[lang].home, canonicalURL);
const personID = `${authorURL}#person`;
const websiteID = `${siteURL}#website`;

const graph: Record<string, unknown>[] = [
  {
    "@type": "Person",
    "@id": personID,
    name: "Lewis Zhou",
    url: authorURL,
    sameAs: ["https://x.com/BartXVs"],
  },
  {
    "@type": "WebSite",
    "@id": websiteID,
    url: siteURL,
    name: text.siteTitle,
    alternateName: lang === "en" ? "持续求解" : "Still Solving",
    description: text.siteDescription,
    inLanguage: lang,
    author: { "@id": personID },
  },
];

if (pageType === "article" && publishedAt) {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${canonicalURL}#article`,
    mainEntityOfPage: canonicalURL,
    url: canonicalURL,
    headline: title,
    description,
    image: socialImage,
    datePublished: publishedAt.toISOString(),
    dateModified: (updatedAt ?? publishedAt).toISOString(),
    articleSection: category,
    inLanguage: lang,
    author: { "@id": personID },
    publisher: { "@id": personID },
    isPartOf: { "@id": websiteID },
  });
} else {
  graph.push({
    "@type": "WebPage",
    "@id": `${canonicalURL}#webpage`,
    url: canonicalURL,
    name: pageTitle,
    description,
    inLanguage: lang,
    isPartOf: { "@id": websiteID },
  });
}

const structuredData = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Lewis Zhou" />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={text.siteTitle} href={paths[lang].rss} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, siteURL)} />
    ))}
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={text.siteTitle} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "zh_CN"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {category && <meta property="article:section" content={category} />}
    {pageType === "article" && <meta property="article:author" content="Lewis Zhou" />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "en" ? "Skip to content" : "跳到正文"}</a>
    <div class="page-shell">
      <Header lang={lang} languageHref={alternates.find((alternate) => alternate.lang !== lang)?.href ?? paths[lang === "en" ? "zh-CN" : "en"].home} />
      <main id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <p>{text.footerName} · <a href="https://x.com/BartXVs" rel="me" aria-label={lang === "en" ? "Lewis Zhou on X (@BartXVs)" : "Lewis Zhou 的 X（@BartXVs）"}>X ↗</a></p>
        <p>{text.footerLine}</p>
      </footer>
    </div>
  </body>
</html>
