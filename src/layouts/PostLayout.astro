---
import BaseLayout from "./BaseLayout.astro";
import { paths, ui, type Locale } from "../i18n";

interface Alternate {
  lang: Locale;
  href: string;
}

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  categoryHref: string;
  lang: Locale;
  alternates: Alternate[];
}

const { title, description, publishedAt, updatedAt, category, categoryHref, lang, alternates } = Astro.props;
const text = ui[lang];
const formatDate = (date: Date) => new Intl.DateTimeFormat(lang === "en" ? "en-US" : "zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  alternates={alternates}
  pageType="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  category={category}
>
  <article class="post-page">
    <header class="post-header">
      <a class="back-link" href={paths[lang].writing}>{text.backToWriting}</a>
      <div class="post-kicker">
        <span><a href={paths[lang].about} rel="author">Lewis Zhou</a> · <a href={categoryHref}>{category}</a></span>
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
      </div>
      <h1>{title}</h1>
      <p>{description}</p>
      {updatedAt && <small>{text.updated} {formatDate(updatedAt)}</small>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
